# Copy to .env.local. Never commit real keys.
# Network: chipnet (default) or mainnet. Mainnet must be set explicitly.
NEXT_PUBLIC_BCH_NETWORK=chipnet

# Banner (BCH BLAZE requirement)
NEXT_PUBLIC_SLIDES_URL=
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_EMBER_ADDRESS=

# Default verifier public key (33-byte hex). Demo verifier = centralised, see README.
NEXT_PUBLIC_VERIFIER_PUBKEY=

# scripts/chipnet.mts only (throwaway chipnet keys, created by `npm run keys`)
CHIPNET_STAKER_WIF=
CHIPNET_VERIFIER_WIF=
CHIPNET_BENEFICIARY_WIF=
# set to "rest" if your network blocks Electrum ports (50004)
CHIPNET_PROVIDER=
