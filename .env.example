# Copy to .env.local for local dev. Never commit real keys (.env.local is gitignored).
# On Vercel, set the same names in Project Settings -> Environment Variables.

# ---- Public (bundled into the browser; NEXT_PUBLIC_ = visible to everyone) ----

# Network: "chipnet" (default) or "mainnet". Mainnet only when set explicitly.
NEXT_PUBLIC_BCH_NETWORK=chipnet

# Chain access: "auto" (default: Electrum wss in the browser, falls back to the app's
# HTTPS REST route /api/chain/* on connection failure), "electrum" (Electrum only),
# or "rest" (HTTPS only, via /api/chain/* -> mainnet.cash watch-only REST).
NEXT_PUBLIC_BCH_PROVIDER=auto

# Banner links (BCH BLAZE requirement). Empty = shown as a TODO placeholder.
NEXT_PUBLIC_SLIDES_URL=
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_EMBER_ADDRESS=

# ---- Server-only (NEVER prefix with NEXT_PUBLIC_) ----

# Private key (WIF) of the Vouch demo verifier, operated by this app. Legacy name from
# before the rename to Vouch; kept because it's already set on Vercel. Used only by
# /api/verifier to co-sign KEEP after the user's confirm step (it never signs a break;
# honour system). Unset = the demo
# verifier is disabled and users must name a friend as verifier. Changing it orphans
# existing demo pledges (their contracts commit to the old pubkey). Keep it on the
# network you deploy (chipnet WIF for chipnet). Generate with `npm run keys`.
COMMITCASH_VERIFIER_WIF=

# ---- Local scripts only (not needed on Vercel) ----
# scripts/chipnet.mts and scripts/e2e-app.mts: throwaway chipnet keys from `npm run keys`
CHIPNET_STAKER_WIF=
CHIPNET_VERIFIER_WIF=
CHIPNET_BENEFICIARY_WIF=
# set to "rest" if your network blocks Electrum ports (50004/50002)
CHIPNET_PROVIDER=
